# ─── Muhit ───
NODE_ENV=development
# all | bot | worker  (production: bot va worker alohida jarayonlar sifatida ham ishlaydi)
APP_ROLE=all
LOG_LEVEL=info
HTTP_PORT=3000

# ─── Telegram ───
# BotFather dan olingan token. HECH QACHON gitga joylamang.
BOT_TOKEN=
# Ixtiyoriy: getMe orqali avtomatik aniqlanadi
BOT_USERNAME=
# polling (lokal) | webhook (production, HTTPS)
TELEGRAM_MODE=polling
# webhook rejimida: https://domen/telegram/webhook
WEBHOOK_URL=
# webhook rejimida: kamida 16 belgili tasodifiy satr
WEBHOOK_SECRET=

# ─── Ma'lumotlar bazasi va Redis ───
DATABASE_URL=postgresql://mafia:mafia@127.0.0.1:5432/mafia
REDIS_URL=redis://127.0.0.1:6379

# ─── Boshqaruv ───
# Bot egasi(lar)ning Telegram user ID lari, vergul bilan (masalan: 123456789,987654321)
SUPERADMIN_IDS=
DEFAULT_LOCALE=uz
TIMEZONE=Asia/Tashkent

# ─── Faqat development ───
# true bo'lsa guruhda /devfill N — bot-o'yinchilar bilan sinash. Productionda taqiqlangan.
DEV_FAKE_PLAYERS=false
